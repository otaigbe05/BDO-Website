{
  "redirects": [
    { "source": "/legal", "destination": "/privacy-policy", "permanent": true },
    { "source": "/templates", "destination": "/templates/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/templates/:path*", "destination": "https://omis-showcase.pages.dev/templates/:path*" },
    { "source": "/((?!api/|templates/).*)", "destination": "/index.html" }
  ]
}
